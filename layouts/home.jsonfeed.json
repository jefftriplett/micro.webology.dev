{{- $items := slice -}}
{{- range first 25 (where site.RegularPages "Type" "post") -}}
  {{- $item := dict "id" (.Params.feed_id | default .Permalink) "url" .Permalink "title" .Title "content_html" .Content "date_published" (.Date.Format "2006-01-02T15:04:05-07:00") -}}
  {{- with .Params.summary }}{{ $item = merge $item (dict "summary" .) }}{{ end -}}
  {{- with .Params.categories }}{{ $item = merge $item (dict "tags" .) }}{{ end -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- dict "version" "https://jsonfeed.org/version/1" "title" site.Title "icon" (site.Params.author.avatar | absURL) "home_page_url" site.BaseURL "feed_url" ("feed.json" | absURL) "items" $items | jsonify (dict "indent" "  ") -}}
